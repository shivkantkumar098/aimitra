{
  "mcpServers": {
    "jira": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://shivkantkr.atlassian.net/",
        "JIRA_USERNAME": "shivkantkr",
        "JIRA_API_TOKEN": "${input:jira-api-token}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "jira-api-token",
      "description": "Jira API token",
      "password": true
    }
  ]
}
