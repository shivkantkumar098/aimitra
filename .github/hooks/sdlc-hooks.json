{
  "hooks": {
    "PreToolUse": [
      { "type": "command", "command": "node scripts/sdlc/hooks/protect-secrets.js", "timeout": 10 },
      { "type": "command", "command": "node scripts/sdlc/hooks/block-unsafe-ops.js", "timeout": 15 }
    ],
    "PostToolUse": [
      { "type": "command", "command": "node scripts/sdlc/hooks/audit-log.js", "timeout": 10 },
      { "type": "command", "command": "node scripts/sdlc/hooks/validate-docs.js", "timeout": 30 }
    ],
    "SubagentStart": [
      { "type": "command", "command": "node scripts/sdlc/hooks/audit-log.js", "timeout": 10 }
    ],
    "SubagentStop": [
      { "type": "command", "command": "node scripts/sdlc/hooks/audit-log.js", "timeout": 10 }
    ]
  }
}
